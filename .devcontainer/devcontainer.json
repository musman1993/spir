{
  "name": "SPIR",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [5173, 8787],
  "portsAttributes": {
    "5173": { "label": "SPIR web", "onAutoForward": "openBrowser" },
    "8787": { "label": "SPIR API" }
  },
  "postCreateCommand": "npm install && ([ -f .env ] || cp .env.example .env) && (npm install -g neon@latest || echo 'Neon CLI install skipped - run: npm install -g neon@latest')",
  "customizations": {
    "vscode": {
      "extensions": [
        "mechatroner.rainbow-csv",
        "42Crunch.vscode-openapi"
      ]
    }
  }
}
