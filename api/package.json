{
  "name": "@spir/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "dev:memory": "tsx scripts/dev-memory.ts",
    "start": "tsx --env-file-if-exists=../.env src/server.ts",
    "db:migrate": "tsx --env-file-if-exists=../.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../.env scripts/seed.ts",
    "db:reset": "tsx --env-file-if-exists=../.env scripts/reset.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@hono/node-server": "^1.13.7",
    "@neon/functions": "^0.11.0",
    "csv-parse": "^5.6.0",
    "hono": "^4.6.14",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
