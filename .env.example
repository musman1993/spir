# Copy to .env (never commit .env). In Codespaces: cp .env.example .env
#
# 1) Database - from Neon console > Connect (or run `neon link`, which writes it for you).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
#
# 2) Object Storage - from Neon console > Credentials (or `neon env pull` after `neon deploy`).
#    Leave blank to store files on local disk (.data/storage) while developing.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://br-proud-night-bdzfeuyu.storage.c-8.us-east-2.aws.neon.tech
AWS_REGION=us-east-2
SPIR_BUCKET=spir
#
# 3) QR token encryption key (32 random bytes, base64). Generate with:
#    node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
QR_TOKEN_KEY=
#
# 4) Web app settings
ALLOWED_ORIGINS=*
# Public URL of the web app, used inside printed QR codes, e.g. https://musman1993.github.io/spir
PUBLIC_APP_URL=http://localhost:5173
AUTH_MODE=demo
PORT=8787
